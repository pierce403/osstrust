{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osstrust",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "osstrust.org/*",
      "zone_name": "osstrust.org"
    }
  ]
}
