{
  "name": "osstrust",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "npm run build:cloudflare",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "wrangler deploy",
    "build:cloudflare": "vite build && node scripts/write-deployment.mjs dist/client",
    "check:deploy": "npm run build:cloudflare && wrangler deploy --dry-run"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vinext": "1.1.0",
    "react-server-dom-webpack": "19.3.0",
    "@vinext/cloudflare": "1.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "@cloudflare/vite-plugin": "1.63.1",
    "wrangler": "4.149.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.7.5"
  }
}
